#!/bin/busybox sh

set -o pipefail

mount -n -t proc proc /proc || fatal "Failure mount /proc"
echo 0 > /proc/sys/kernel/printk

mount -n -t devtmpfs devtmpfs /dev || fatal "Failure mount /dev"

exec 0</dev/console
exec 1>/dev/console
exec 2>/dev/console

mkdir -m 0755 /dev/pts || fatal "Failure create directory /dev/pts with perms 755"
mount -n -t devpts -o gid=5,mode=0620 devpts /dev/pts || fatal "Failure mount /dev/pts"

mount -n -t sysfs sysfs /sys || fatal "Failure mount /dev/pts"
mount -n -t tmpfs -o rw,nodev,mode=755 none /run || fatal "Failure mount /run"

cat /BANNER

source /init-base.functions
source /init-platform.functions

# Set up busybox'es symlinks
/bin/busybox --install -s || fatal "Failure install busybox symlinks"

# touch /var/log/lastlog || fatal "Failure create /var/log/lastlog"

# ln -s /proc/mounts /etc/mtab || fatal "Failure link /etc/mtab -> /proc/mounts"

if ! /sbin/ip link show eth0 >/dev/null 2>&1; then 
    warn "A network device 'eth0' is not found. Reboot in 5 seconds..."
    sleep 5
    reboot -f
fi

VOLUME_GROUPS=""
PREBOOT_CMDLINE=""
info "Checking for custom boot confguration ..."
for BLOCK_DEV in $(grep . /sys/class/block/*/device/model | cut -d/ -f5); do
    if [ -n "${VOLUME_GROUPS}" -a -n "${PREBOOT_CMDLINE}" ]; then
        break
    fi

    FIRST_PARTITION_DEV="/dev/${BLOCK_DEV}1"
    info "Examine device '${FIRST_PARTITION_DEV}' ..."
    FIRST_PARTITION_TYPE=""
    for INFO_PAIR in $(blkid "${FIRST_PARTITION_DEV}" | cut -d: -f2); do
        INFO_KEY="$(echo "${INFO_PAIR}" | cut -d= -f1)"
        if [ "${INFO_KEY}" == "TYPE" ]; then
            FIRST_PARTITION_TYPE="$(echo "${INFO_PAIR}" | cut -d= -f2)"
            break
        fi
    done
    info "Partition type of '${FIRST_PARTITION_DEV}' is '${FIRST_PARTITION_TYPE}'"

    if [ "${FIRST_PARTITION_TYPE}" == '"vfat"' || "${FIRST_PARTITION_TYPE}" ==  '"linux_raid_member"' ]; then
        info "Found boot device candidate: ${FIRST_PARTITION_DEV}"
        if ! mount -t vfat -o ro "${FIRST_PARTITION_DEV}" /mnt; then
            info "Unable to mount '${FIRST_PARTITION_DEV}'. Skipped."
            continue
        fi

        if [ -z "${PREBOOT_CMDLINE}" -a -f /mnt/OSFORDEV_CMDLINE ]; then
            info "File OSFORDEV_CMDLINE found on ${FIRST_PARTITION_DEV} ..."
            PREBOOT_CMDLINE=$(head -n 1 /mnt/OSFORDEV_CMDLINE)
            # trim spaces
            PREBOOT_CMDLINE=$(echo "${PREBOOT_CMDLINE}" | xargs)
            info "PREBOOT_CMDLINE: '${PREBOOT_CMDLINE}'"
        fi
        
        if [ -z "${VOLUME_GROUPS}" -a -f /mnt/osfordev-vgs-assembler.sh -a ! -x /tmp/osfordev-vgs-assembler.sh ]; then
            info "Script /osfordev-vgs-assembler.sh found on ${FIRST_PARTITION_DEV} ..."
            cp -a /mnt/osfordev-vgs-assembler.sh /tmp/osfordev-vgs-assembler.sh
            RAW_VOLUME_GROUPS=$(/tmp/osfordev-vgs-assembler.sh up)
            for RAW_VOLUME_GROUP in ${RAW_VOLUME_GROUPS}; do
                VOLUME_GROUPS="${VOLUME_GROUPS} ${RAW_VOLUME_GROUP}"
            done
            # trim spaces
            VOLUME_GROUPS=$(echo "${VOLUME_GROUPS}" | xargs)

            if [ -z "${VOLUME_GROUPS}" ]; then
                fatal "Contract violation. Custom VGs assembler did not retrun volume group name(s)."
            fi

            info "Custom volume groups: '${VOLUME_GROUPS}'"
            
        fi

        umount "${FIRST_PARTITION_DEV}"
    fi
done

if [ -z "${VOLUME_GROUPS}" ]; then
    VOLUME_GROUPS="vgroot"

    info "Scanning for volume groups ..."
    /sbin/vgscan || fatal "/sbin/vgscan: Failure scan volume groups"

    info "Activating volume group: '${VOLUME_GROUPS}' ..."
    /sbin/vgchange --activate y ${VOLUME_GROUPS} || fatal "/sbin/vgchange: Failure activate volume groups '${VOLUME_GROUPS}'"
fi

# By contract, custom VGs assembler script must return root VG first
VGROOT=$(echo "${VOLUME_GROUPS}" | cut -f1)
info "Mounting 'system' logical volume ..."
mount -o ro "/dev/${VGROOT}/system" /mnt || fatal "mount: Failure mount logical volume '/dev/${VGROOT}/system'"

BOOT_CMDLINE=""
if [ -f /mnt/boot/OSFORDEV_CMDLINE ]; then
    BOOT_CMDLINE="$(head -n 1 /mnt/boot/OSFORDEV_CMDLINE)"
    info "Additional command line: ${BOOT_CMDLINE}"
fi

#invite_to_shell 3

info "Loading kernel and initramfs into kexec ..."
kexec --load /mnt/boot/vmlinuz --initrd=/mnt/boot/initramfs.cpio.gz --append="panic=10 net.ifnames=0 ${PREBOOT_CMDLINE} ${BOOT_CMDLINE}" || fatal "kexec: Unable to load kernel/initrams."

/tmp/osfordev-vgs-assembler.sh down

info "Run kexec ..."
invite_to_shell 2
kexec --exec || fatal "kexec: Unable to execute."
